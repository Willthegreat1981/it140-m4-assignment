# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template

START hilow_game

    OUTPUT "Welcome to the higher/lower game, Bella!"

    # Establish a valid guessing range.
    OUTPUT "Enter the lower bound:"
    INPUT lower_bound

    OUTPUT "Enter the upper bound:"
    INPUT upper_bound

    WHILE lower_bound >= upper_bound
        OUTPUT "The lower bound must be less than the upper bound."
        OUTPUT "Enter the lower bound:"
        INPUT lower_bound
        OUTPUT "Enter the upper bound:"
        INPUT upper_bound
    END WHILE

    # Establish the number the player is trying to guess.
    SET random_number = random number between lower_bound and upper_bound

    # Play the game.
    OUTPUT "Great, now guess a number between " + lower_bound + " and " + upper_bound + ":"
    INPUT guess

    WHILE guess < lower_bound OR guess > upper_bound
        OUTPUT "Please enter a number between " + lower_bound + " and " + upper_bound + "."
        OUTPUT "Guess another number:"
        INPUT guess
    END WHILE

    WHILE guess != random_number

        IF guess < random_number THEN
            OUTPUT "Nope, too low."
        ELSE
            OUTPUT "Nope, too high."
        END IF

        OUTPUT "Guess another number:"
        INPUT guess

        WHILE guess < lower_bound OR guess > upper_bound
            OUTPUT "Please enter a number between " + lower_bound + " and " + upper_bound + "."
            OUTPUT "Guess another number:"
            INPUT guess
        END WHILE

    END WHILE

    OUTPUT "You got it!"

END hilow_game
